#!/usr/bin/env bash
# Displays DNS info for a domain's subdomains (www, lb-01, web-01, web-02)
# or for a single specified subdomain.
# Usage: ./0-world_wide_web <domain> [subdomain]

domain=$1
subdomain=$2

# Prints DNS info for a single subdomain of $domain
print_subdomain_info() {
    local sub=$1
    local record_type
    local destination

    read -r record_type destination <<< "$(dig "${sub}.${domain}" | awk '
        /^;; ANSWER SECTION:/ { getline; print $4, $5; exit }
    ')"

    echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
}

if [ -n "$subdomain" ]; then
    print_subdomain_info "$subdomain"
else
    for sub in www lb-01 web-01 web-02; do
        print_subdomain_info "$sub"
    done
fi

exit 0
